{
  "name": "dana-dataconversion",
  "version": "1.0.0",
  "description": "Minimal API for file conversion between xls ,xlsx ,csv and txt for specific file templates",
  "main": "index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "dev:backend": "node index.js",
    "build": "npm install --include=dev && node esbuild.config.js build",
    "dev:frontend": "node esbuild.config.js dev",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run build && node index.js"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "connect-mongo": "^5.1.0",
    "csv-parser": "^3.2.1",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "fuse.js": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.3",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "ssh2-sftp-client": "^12.1.1",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "esbuild": "^0.28.2",
    "fs-extra": "^11.2.0",
    "nodemon": "^3.1.10"
  },
  "overrides": {
    "uuid": "$uuid"
  }
}
